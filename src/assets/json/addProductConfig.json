      },
      {
        "key": "customField2",
        "label": "Custom Field",
        "type": "text",
        "placeholder": "Placeholder",
        "row": 2
      },
      {
        "key": "customField3",
        "label": "Custom Field",
        "type": "text",
        "placeholder": "Placeholder",
        "row": 2
      },
      {
        "key": "status",
        "label": "Status",
        "type": "select",
        "placeholder": "Choose",
        "options": ["Active", "Inactive", "Not Available"],
        "row": 2
      }
