          "type": "number",
          "placeholder": "Placeholder"
        },
        {
          "key": "customField3",
          "label": "Custom Fields",
          "type": "number",
          "placeholder": "Placeholder"
        }
      ]
    },

    {
      "id": "Products",
      "label": "Products",
      "icon": "FiGrid",
      "appliesTo": "type",
      "fields": [
        {
          "key": "customField1",
          "label": "Custom Fields",
          "type": "number",
          "placeholder": "Placeholder"
        },
        {
          "key": "customField2",
          "label": "Custom Fields",
          "type": "number",
          "placeholder": "Placeholder"
        },
        {
          "key": "customField3",
          "label": "Custom Fields",
          "type": "number",
          "placeholder": "Placeholder"
        }
      ]
